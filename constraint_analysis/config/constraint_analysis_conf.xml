<?xml version="1.0" encoding="UTF-8"?>
<module_configuration_file name="constraint_analysis.xml">

  <!-- ====================================================== -->
  <!-- Default selection                                      -->
  <!-- ====================================================== -->
  <control_settings>
    <active_constraint_case_ID><value>JET_PW1127GJM_BASELINE</value></active_constraint_case_ID>
  </control_settings>

  <program_settings>

    <!-- ==================================================== -->
    <!-- Reusable constraint sets                             -->
    <!-- ==================================================== -->
    <constraint_sets>

      <!-- Baseline requirements shared by all non-specialized cases. -->
      <standard_set ID="BASELINE_STANDARD_SET">

        <!-- Ground performance -->
        <takeoff_ground_roll ID="TO_BASELINE">
          <active><value>true</value></active>
          <altitude><value>0.0</value></altitude>
          <!-- Project-defined normal-field takeoff ground-roll requirement. -->
          <takeoff_ground_roll_m><value>1200.0</value></takeoff_ground_roll_m>
          <k_TO><value>1.2</value></k_TO>
          <friction_coefficient><value>0.02</value></friction_coefficient>
          <ground_drag_coefficient><value>0.04</value></ground_drag_coefficient>
        </takeoff_ground_roll>

        <landing_field_length ID="LDG_BASELINE">
          <active><value>true</value></active>
          <altitude><value>0.0</value></altitude>
          <!-- Project-defined normal-field landing braking-roll requirement. -->
          <landing_braking_roll_m><value>1000.0</value></landing_braking_roll_m>
          <k_TD><value>1.15</value></k_TD>
          <friction_coefficient><value>0.40</value></friction_coefficient>
          <braking_drag_coefficient><value>0.10</value></braking_drag_coefficient>
        </landing_field_length>

        <stall_speed ID="STALL_BASELINE">
          <active><value>true</value></active>
          <stall_speed_limit><value>65.0</value></stall_speed_limit>
        </stall_speed>

        <!-- Atmospheric / structural limit -->
        <gust ID="GUST_BASELINE">
          <active><value>true</value></active>
          <automatic_values><value>true</value></automatic_values>
        </gust>

        <!-- High-speed flight -->
        <max_mach ID="MMO_BASELINE">
          <active><value>true</value></active>
          <altitude><value>9000.0</value></altitude>
          <Mach><value>0.78</value></Mach>
        </max_mach>

        <!-- Fixed values are retained for the propeller reference case.
             Jet acceleration and cruise scan the mission CSV instead. -->
        <horizontal_acceleration ID="ACC_BASELINE">
          <active><value>true</value></active>
          <altitude><value>8000.0</value></altitude>
          <speed><value>180.0</value></speed>
          <acceleration><value>1.5</value></acceleration>
        </horizontal_acceleration>

        <cruise ID="CR_BASELINE">
          <active><value>true</value></active>
          <altitude><value>6000.0</value></altitude>
          <speed><value>180.0</value></speed>
        </cruise>

        <climb ID="CL_BASELINE">
          <active><value>true</value></active>
          <!-- The complete mission climb segment defines this constraint. -->
        </climb>

        <constant_speed_turn ID="TURN_BASELINE">
          <active><value>true</value></active>
          <altitude><value>3000.0</value></altitude>
          <speed><value>120.0</value></speed>
          <load_factor><value>2.5</value></load_factor>
        </constant_speed_turn>

        <!-- Mission requirement -->
        <range_fuel_fraction ID="RANGE_BASELINE">
          <active><value>true</value></active>
          <available_fuel_fraction><value>0.25</value></available_fuel_fraction>
        </range_fuel_fraction>

      </standard_set>

      <!-- Only runway requirements differ from the baseline case. -->
      <standard_set ID="SHORT_FIELD_STANDARD_SET">

        <takeoff_ground_roll ID="TO_SHORT">
          <active><value>true</value></active>
          <altitude><value>0.0</value></altitude>
          <!-- Project-defined short-field takeoff ground-roll requirement. -->
          <takeoff_ground_roll_m><value>800.0</value></takeoff_ground_roll_m>
          <k_TO><value>1.2</value></k_TO>
          <friction_coefficient><value>0.02</value></friction_coefficient>
          <ground_drag_coefficient><value>0.04</value></ground_drag_coefficient>
        </takeoff_ground_roll>

        <landing_field_length ID="LDG_SHORT">
          <active><value>true</value></active>
          <altitude><value>0.0</value></altitude>
          <!-- Project-defined short-field landing braking-roll requirement. -->
          <landing_braking_roll_m><value>700.0</value></landing_braking_roll_m>
          <k_TD><value>1.15</value></k_TD>
          <friction_coefficient><value>0.40</value></friction_coefficient>
          <braking_drag_coefficient><value>0.10</value></braking_drag_coefficient>
        </landing_field_length>

        <stall_speed ID="STALL_SHORT">
          <active><value>true</value></active>
          <stall_speed_limit><value>65.0</value></stall_speed_limit>
        </stall_speed>

        <gust ID="GUST_SHORT">
          <active><value>true</value></active>
          <automatic_values><value>true</value></automatic_values>
        </gust>

        <max_mach ID="MMO_SHORT">
          <active><value>true</value></active>
          <altitude><value>9000.0</value></altitude>
          <Mach><value>0.78</value></Mach>
        </max_mach>

        <!-- Fixed values are retained for the propeller reference case.
             Jet acceleration and cruise scan the mission CSV instead. -->
        <horizontal_acceleration ID="ACC_SHORT">
          <active><value>true</value></active>
          <altitude><value>8000.0</value></altitude>
          <speed><value>180.0</value></speed>
          <acceleration><value>1.5</value></acceleration>
        </horizontal_acceleration>

        <cruise ID="CR_SHORT">
          <active><value>true</value></active>
          <altitude><value>6000.0</value></altitude>
          <speed><value>180.0</value></speed>
        </cruise>

        <climb ID="CL_SHORT">
          <active><value>true</value></active>
          <!-- The complete mission climb segment defines this constraint. -->
        </climb>

        <constant_speed_turn ID="TURN_SHORT">
          <active><value>true</value></active>
          <altitude><value>3000.0</value></altitude>
          <speed><value>120.0</value></speed>
          <load_factor><value>2.5</value></load_factor>
        </constant_speed_turn>

        <range_fuel_fraction ID="RANGE_SHORT">
          <active><value>true</value></active>
          <available_fuel_fraction><value>0.25</value></available_fuel_fraction>
        </range_fuel_fraction>

      </standard_set>

      <!-- Project-defined long-field scenario. Only runway requirements
           differ from the baseline set. Values are ground-roll requirements,
           not certified total field lengths. -->
      <standard_set ID="LONG_FIELD_STANDARD_SET">

        <takeoff_ground_roll ID="TO_LONG">
          <active><value>true</value></active>
          <altitude><value>0.0</value></altitude>
          <takeoff_ground_roll_m><value>1800.0</value></takeoff_ground_roll_m>
          <k_TO><value>1.2</value></k_TO>
          <friction_coefficient><value>0.02</value></friction_coefficient>
          <ground_drag_coefficient><value>0.04</value></ground_drag_coefficient>
        </takeoff_ground_roll>

        <landing_field_length ID="LDG_LONG">
          <active><value>true</value></active>
          <altitude><value>0.0</value></altitude>
          <landing_braking_roll_m><value>1500.0</value></landing_braking_roll_m>
          <k_TD><value>1.15</value></k_TD>
          <friction_coefficient><value>0.40</value></friction_coefficient>
          <braking_drag_coefficient><value>0.10</value></braking_drag_coefficient>
        </landing_field_length>

        <stall_speed ID="STALL_LONG">
          <active><value>true</value></active>
          <stall_speed_limit><value>65.0</value></stall_speed_limit>
        </stall_speed>

        <gust ID="GUST_LONG">
          <active><value>true</value></active>
          <automatic_values><value>true</value></automatic_values>
        </gust>

        <max_mach ID="MMO_LONG">
          <active><value>true</value></active>
          <altitude><value>9000.0</value></altitude>
          <Mach><value>0.78</value></Mach>
        </max_mach>

        <horizontal_acceleration ID="ACC_LONG">
          <active><value>true</value></active>
          <altitude><value>8000.0</value></altitude>
          <speed><value>180.0</value></speed>
          <acceleration><value>1.5</value></acceleration>
        </horizontal_acceleration>

        <cruise ID="CR_LONG">
          <active><value>true</value></active>
          <altitude><value>6000.0</value></altitude>
          <speed><value>180.0</value></speed>
        </cruise>

        <climb ID="CL_LONG">
          <active><value>true</value></active>
        </climb>

        <constant_speed_turn ID="TURN_LONG">
          <active><value>true</value></active>
          <altitude><value>3000.0</value></altitude>
          <speed><value>120.0</value></speed>
          <load_factor><value>2.5</value></load_factor>
        </constant_speed_turn>

        <range_fuel_fraction ID="RANGE_LONG">
          <active><value>true</value></active>
          <available_fuel_fraction><value>0.25</value></available_fuel_fraction>
        </range_fuel_fraction>

      </standard_set>
    </constraint_sets>

    <!-- ==================================================== -->
    <!-- Analysis cases                                       -->
    <!-- ==================================================== -->
    <constraint_cases active_case_ID="JET_V2527A5_BASELINE">

      <constraint_case ID="JET_V2527A5_BASELINE"
                       description="SMR-01 analysis with the V2527-A5 test engine deck">
        <aircraft>
          <aerodynamics>
            <polar_xml_path><value>../libraries/aerodynamics/test/stubs/PEF-v2/polar (4).xml</value></polar_xml_path>
            <reference_wing_ID><value>main_wing</value></reference_wing_ID>
          </aerodynamics>
        </aircraft>

        <mission>
          <mission_csv_path><value>../UNICADO-SMR-01/clean_sheet_design/mission_data/UNICADO-SMR-01_design_mission_R2450_PL19300_out.csv</value></mission_csv_path>
        </mission>

        <engine>
          <engine_directory_path><value>../libraries/engine/test/stubs/V2527-A5</value></engine_directory_path>
        </engine>

        <design_space>
          <wing_loading_min><value>1000.0</value></wing_loading_min>
          <wing_loading_max><value>7000.0</value></wing_loading_max>
          <wing_loading_step><value>100.0</value></wing_loading_step>
        </design_space>

        <constraints>
          <constraint_set_ref><value>BASELINE_STANDARD_SET</value></constraint_set_ref>
        </constraints>
      </constraint_case>

      <constraint_case ID="JET_PW1127GJM_BASELINE"
                       description="SMR-01 analysis with the PW1127G-JM mission engine deck">
        <aircraft>
          <aerodynamics>
            <polar_xml_path><value>../libraries/aerodynamics/test/stubs/PEF-v2/polar (4).xml</value></polar_xml_path>
            <reference_wing_ID><value>main_wing</value></reference_wing_ID>
          </aerodynamics>
        </aircraft>

        <mission>
          <mission_csv_path><value>../UNICADO-SMR-01/clean_sheet_design/mission_data/UNICADO-SMR-01_design_mission_R2450_PL19300_out.csv</value></mission_csv_path>
        </mission>

        <engine>
          <engine_directory_path><value>../UNICADO-SMR-01/clean_sheet_design/engine_data/PW1127G-JM</value></engine_directory_path>
        </engine>

        <design_space>
          <wing_loading_min><value>1000.0</value></wing_loading_min>
          <wing_loading_max><value>9000.0</value></wing_loading_max>
          <wing_loading_step><value>100.0</value></wing_loading_step>
        </design_space>

        <constraints>
          <constraint_set_ref><value>BASELINE_STANDARD_SET</value></constraint_set_ref>
        </constraints>
      </constraint_case>

      <constraint_case ID="JET_PW1127GJM_SHORT_FIELD"
                       description="PW1127G-JM real-engine short-field ground-roll sizing case">
        <aircraft>
          <aerodynamics>
            <polar_xml_path><value>../libraries/aerodynamics/test/stubs/PEF-v2/polar (4).xml</value></polar_xml_path>
            <reference_wing_ID><value>main_wing</value></reference_wing_ID>
          </aerodynamics>
        </aircraft>

        <mission>
          <mission_csv_path><value>../UNICADO-SMR-01/clean_sheet_design/mission_data/UNICADO-SMR-01_design_mission_R2450_PL19300_out.csv</value></mission_csv_path>
        </mission>

        <engine>
          <engine_directory_path><value>../UNICADO-SMR-01/clean_sheet_design/engine_data/PW1127G-JM</value></engine_directory_path>
        </engine>

        <design_space>
          <wing_loading_min><value>1000.0</value></wing_loading_min>
          <wing_loading_max><value>7000.0</value></wing_loading_max>
          <wing_loading_step><value>100.0</value></wing_loading_step>
        </design_space>

        <constraints>
          <constraint_set_ref><value>SHORT_FIELD_STANDARD_SET</value></constraint_set_ref>
        </constraints>
      </constraint_case>

      <constraint_case ID="JET_PW1127GJM_LONG_FIELD"
                       description="PW1127G-JM real-engine long-field ground-roll sizing case">
        <aircraft>
          <aerodynamics>
            <polar_xml_path><value>../libraries/aerodynamics/test/stubs/PEF-v2/polar (4).xml</value></polar_xml_path>
            <reference_wing_ID><value>main_wing</value></reference_wing_ID>
          </aerodynamics>
        </aircraft>

        <mission>
          <mission_csv_path><value>../UNICADO-SMR-01/clean_sheet_design/mission_data/UNICADO-SMR-01_design_mission_R2450_PL19300_out.csv</value></mission_csv_path>
        </mission>

        <engine>
          <engine_directory_path><value>../UNICADO-SMR-01/clean_sheet_design/engine_data/PW1127G-JM</value></engine_directory_path>
        </engine>

        <design_space>
          <wing_loading_min><value>1000.0</value></wing_loading_min>
          <wing_loading_max><value>7000.0</value></wing_loading_max>
          <wing_loading_step><value>100.0</value></wing_loading_step>
        </design_space>

        <constraints>
          <constraint_set_ref><value>LONG_FIELD_STANDARD_SET</value></constraint_set_ref>
        </constraints>
      </constraint_case>

      <constraint_case ID="PROPELLER_UNICADO_BASELINE"
                       description="Propeller power-loading constraint analysis using the supplied UNICADO data">
        <aircraft>
          <aerodynamics>
            <polar_xml_path><value>../libraries/aerodynamics/test/stubs/PEF-v2/polar (4).xml</value></polar_xml_path>
            <reference_wing_ID><value>main_wing</value></reference_wing_ID>
          </aerodynamics>
        </aircraft>

        <mission>
          <mission_csv_path><value>../UNICADO-SMR-01/clean_sheet_design/mission_data/UNICADO-SMR-01_design_mission_R2450_PL19300_out.csv</value></mission_csv_path>
        </mission>

        <engine>
          <propulsion_type><value>propeller</value></propulsion_type>
          <propeller>
            <!-- Authoritative inputs for the available-data propeller analysis. -->
            <deck_path><value>../libraries/aerodynamics/test/stubs/engine/propeller/prop.csv</value></deck_path>
            <diameter><value>3.96</value></diameter>
            <!-- Supervisor-defined maximum helical blade-tip Mach number. -->
            <tip_mach_limit><value>0.95</value></tip_mach_limit>
            <count><value>2</value></count>
            <takeoff>
              <RPM><value>1200.0</value></RPM>
            </takeoff>
          </propeller>
        </engine>

        <design_space>
          <wing_loading_min><value>1000.0</value></wing_loading_min>
          <wing_loading_max><value>7000.0</value></wing_loading_max>
          <wing_loading_step><value>100.0</value></wing_loading_step>
        </design_space>

        <constraints>
          <constraint_set_ref><value>BASELINE_STANDARD_SET</value></constraint_set_ref>
        </constraints>
      </constraint_case>

    </constraint_cases>
  </program_settings>
</module_configuration_file>
