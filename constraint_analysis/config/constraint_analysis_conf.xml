<?xml version="1.0" encoding="UTF-8"?>
<module_configuration_file name="constraint_analysis.xml">

  <!-- ====================================================== -->
  <!-- Default selection                                      -->
  <!-- ====================================================== -->
  <control_settings>
    <active_constraint_case_ID><value>JET_PW1127GJM_BASELINE</value></active_constraint_case_ID>
  </control_settings>

  <program_settings>

    <method description="Constraint-analysis method; only Energy_Based is implemented">
      <value>Energy_Based</value>
    </method>
    <mode_selection description="mode_0 selects the minimum feasible propulsion loading">
      <value>mode_0</value>
    </mode_selection>

    <!-- ==================================================== -->
    <!-- Reusable constraint sets                             -->
    <!-- ==================================================== -->
    <constraint_selection description="Selectable standard performance constraints">

      <standard_set ID="STANDARD_CONSTRAINT_SET">

        <!-- Matching-chart source: "performance" uses the explicit user
             requirements below; "mission" scans the mission CSV instead. -->
        <condition_source><value>performance</value></condition_source>

        <!-- Equation and ground-operation assumptions. These are model
             settings, not customer performance requirements. -->
        <model_assumptions>
          <takeoff>
            <liftoff_speed_factor_k_TO><value>1.2</value></liftoff_speed_factor_k_TO>
            <rolling_friction_coefficient><value>0.02</value></rolling_friction_coefficient>
            <ground_drag_coefficient><value>0.04</value></ground_drag_coefficient>
          </takeoff>
          <landing>
            <touchdown_speed_factor_k_TD><value>1.15</value></touchdown_speed_factor_k_TD>
            <braking_friction_coefficient><value>0.40</value></braking_friction_coefficient>
            <braking_drag_coefficient><value>0.10</value></braking_drag_coefficient>
          </landing>
        </model_assumptions>

        <takeoff_ground_roll>
          <active>
            <value>true</value>
          </active>
          <altitude><value>0.0</value></altitude>
          <weight_fraction><value>1.0</value></weight_fraction>
          <takeoff_ground_roll_m><value>1200.0</value></takeoff_ground_roll_m>
        </takeoff_ground_roll>

        <landing_field_length>
          <active>
            <value>true</value>
          </active>
          <altitude><value>0.0</value></altitude>
          <weight_fraction><value>0.85</value></weight_fraction>
          <landing_braking_roll_m><value>1000.0</value></landing_braking_roll_m>
        </landing_field_length>

        <stall_speed>
          <active>
            <value>true</value>
          </active>
          <stall_speed_limit><value>65.0</value></stall_speed_limit>
        </stall_speed>

        <gust>
          <active>
            <value>true</value>
          </active>
          <altitude><value>6000.0</value></altitude>
          <speed><value>180.0</value></speed>
          <weight_fraction><value>0.98</value></weight_fraction>
        </gust>

        <max_mach>
          <active>
            <value>true</value>
          </active>
          <altitude><value>9000.0</value></altitude>
          <Mach><value>0.78</value></Mach>
          <weight_fraction><value>0.98</value></weight_fraction>
        </max_mach>

        <horizontal_acceleration>
          <active>
            <value>true</value>
          </active>
          <altitude><value>8000.0</value></altitude>
          <speed><value>180.0</value></speed>
          <acceleration><value>1.5</value></acceleration>
          <climb_rate><value>0.0</value></climb_rate>
          <weight_fraction><value>0.98</value></weight_fraction>
        </horizontal_acceleration>

        <cruise>
          <active>
            <value>true</value>
          </active>
          <altitude><value>6000.0</value></altitude>
          <speed><value>180.0</value></speed>
          <weight_fraction><value>0.98</value></weight_fraction>
        </cruise>

        <climb>
          <active>
            <value>true</value>
          </active>
          <altitude><value>3000.0</value></altitude>
          <speed><value>120.0</value></speed>
          <climb_rate><value>5.0</value></climb_rate>
          <acceleration><value>0.0</value></acceleration>
          <weight_fraction><value>0.99</value></weight_fraction>
        </climb>

        <constant_speed_turn>
          <active>
            <value>true</value>
          </active>
          <altitude><value>3000.0</value></altitude>
          <speed><value>120.0</value></speed>
          <load_factor><value>2.5</value></load_factor>
          <weight_fraction><value>0.98</value></weight_fraction>
        </constant_speed_turn>

        <range_fuel_fraction>
          <active>
            <value>true</value>
          </active>
          <available_fuel_fraction><value>0.25</value></available_fuel_fraction>
        </range_fuel_fraction>

      </standard_set>

    </constraint_selection>

    <!-- ==================================================== -->
    <!-- Analysis cases                                       -->
    <!-- ==================================================== -->
    <constraint_cases>

      <constraint_case ID="JET_PW1127GJM_BASELINE"
                       description="SMR-01 analysis with the PW1127G-JM mission engine deck">
        <aircraft>
          <aerodynamics>
            <polar_xml_path><value>../libraries/aerodynamics/test/stubs/PEF-v2/polar (4).xml</value></polar_xml_path>
            <reference_wing_ID><value>main_wing</value></reference_wing_ID>
          </aerodynamics>
        </aircraft>

        <mission>
          <mission_csv_path><value>../UNICADO-SMR-01/clean_sheet_design/mission_data/UNICADO-SMR-01_design_mission_R2450_PL19300_out.csv</value></mission_csv_path>
        </mission>

        <engine>
          <engine_directory_path><value>../UNICADO-SMR-01/clean_sheet_design/engine_data/PW1127G-JM</value></engine_directory_path>
        </engine>

        <design_space>
          <wing_loading_min><value>1000.0</value></wing_loading_min>
          <wing_loading_max><value>9000.0</value></wing_loading_max>
          <wing_loading_step><value>100.0</value></wing_loading_step>
        </design_space>

        <constraints>
          <constraint_set_ref><value>STANDARD_CONSTRAINT_SET</value></constraint_set_ref>
          <activation_overrides>
            <max_mach><value>true</value></max_mach>
            <range_fuel_fraction><value>true</value></range_fuel_fraction>
          </activation_overrides>
        </constraints>
      </constraint_case>

      <constraint_case ID="PROPELLER_UNICADO_BASELINE"
                       description="Propeller power-loading constraint analysis using the supplied UNICADO data">
        <aircraft>
          <aerodynamics>
            <polar_xml_path><value>../libraries/aerodynamics/test/stubs/PEF-v2/polar (4).xml</value></polar_xml_path>
            <reference_wing_ID><value>main_wing</value></reference_wing_ID>
          </aerodynamics>
        </aircraft>

        <mission>
          <mission_csv_path><value>../UNICADO-SMR-01/clean_sheet_design/mission_data/UNICADO-SMR-01_design_mission_R2450_PL19300_out.csv</value></mission_csv_path>
        </mission>

        <engine>
          <propulsion_type><value>propeller</value></propulsion_type>
          <propeller>
            <!-- Propeller model inputs. -->
            <deck_path><value>../libraries/aerodynamics/test/stubs/engine/propeller/prop.csv</value></deck_path>
            <diameter><value>3.96</value></diameter>
            <!-- Maximum helical blade-tip Mach number. -->
            <tip_mach_limit><value>0.9999</value></tip_mach_limit>
            <count><value>2</value></count>
            <!-- Used only when the propeller deck has no valid cruise point. -->
            <cruise_fallback>
              <altitude><value>6000.0</value></altitude>
              <speed><value>180.0</value></speed>
            </cruise_fallback>
          </propeller>
        </engine>

        <design_space>
          <wing_loading_min><value>1000.0</value></wing_loading_min>
          <wing_loading_max><value>7000.0</value></wing_loading_max>
          <wing_loading_step><value>100.0</value></wing_loading_step>
        </design_space>

        <constraints>
          <constraint_set_ref><value>STANDARD_CONSTRAINT_SET</value></constraint_set_ref>
          <activation_overrides>
            <max_mach><value>false</value></max_mach>
            <range_fuel_fraction><value>false</value></range_fuel_fraction>
          </activation_overrides>
        </constraints>
      </constraint_case>

    </constraint_cases>
  </program_settings>
</module_configuration_file>
